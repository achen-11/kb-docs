[Unit]
Description=Kooboo documentation editor
Wants=network-online.target
After=network-online.target kb-docs-preview-dev.service kb-docs-preview.service

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}
WorkingDirectory={{APP_DIR}}
EnvironmentFile={{CONFIG_DIR}}/editor.env
EnvironmentFile=-{{PREVIEW_ENV_FILE}}
ExecStart=/usr/bin/env node {{APP_DIR}}/scripts/docs-editor-server.mjs
Restart=on-failure
RestartSec=3s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{APP_DIR}} {{PREVIEW_ROOT}}

[Install]
WantedBy=multi-user.target
