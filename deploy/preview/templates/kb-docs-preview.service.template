[Unit]
Description=Kooboo documentation preview server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}
WorkingDirectory={{APP_DIR}}
EnvironmentFile={{CONFIG_DIR}}/preview.env
ExecStart=/usr/bin/env corepack pnpm docs:preview:serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{APP_DIR}} {{DATA_DIR}}

[Install]
WantedBy=multi-user.target
