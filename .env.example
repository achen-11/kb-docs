# 复制为 .env（gitignore，勿提交）
# 用于 scripts/cms-*-screenshots.mjs 等 Playwright 截图脚本（load-env.mjs）

KOOBOO_USER=your-admin-username
KOOBOO_PASS=your-admin-password

# 部署文档站到 Kooboo 请配置 kb-remote-site/.env（见 kb-remote-site/.env.example）

# Optional overrides for commerce screenshots:
# KOOBOO_BASE=https://www.redev.cn
# KOOBOO_SITE_ID=552e81ab-eb2a-cb82-1458-aa61512cedd2
# KOOBOO_PRODUCT_ID=17da841b2ac74c3496c5a1202a0e3e93
