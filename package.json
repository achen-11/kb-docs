{
  "name": "kb-docs",
  "version": "1.0.0",
  "packageManager": "pnpm@10.17.1",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:dev:zh": "DOCS_PREVIEW_ZH=1 vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:preview:server": "node scripts/local-preview-server.mjs",
    "docs:preview:lan": "node scripts/local-preview-server.mjs --host 0.0.0.0",
    "docs:preview:publish": "node scripts/publish-local-preview.mjs",
    "docs:preview:serve": "node scripts/local-preview-server.mjs --no-watch --skip-initial-build",
    "docs:preview:health": "node scripts/check-local-preview.mjs",
    "docs:preview:fast-health": "node scripts/check-docs-fast-preview.mjs",
    "docs:preview:sync": "node scripts/sync-preview-from-git.mjs",
    "docs:editor:build": "vite build --config editor/vite.config.ts",
    "docs:editor:serve": "node scripts/docs-editor-server.mjs",
    "docs:editor:health": "node scripts/check-docs-editor.mjs",
    "test:docs-editor": "node --test scripts/docs-editor-draft.test.mjs scripts/docs-editor-link.test.mjs scripts/docs-editor-media.test.mjs scripts/docs-editor-publish.test.mjs scripts/docs-editor-server.test.mjs scripts/docs-editor-workspace.test.mjs scripts/docs-publish-locale.test.mjs scripts/render-docs-editor-config.test.mjs",
    "docs:build:kooboo": "vitepress build docs && node scripts/stabilize-vitepress-dist.mjs && node scripts/export-vitepress-to-kooboo.mjs",
    "docs:artifact:prepare": "node scripts/prepare-kooboo-artifact.mjs",
    "docs:artifact:prepare:skip-build": "node scripts/prepare-kooboo-artifact.mjs --skip-build",
    "docs:deploy:kooboo": "node scripts/deploy-kooboo-artifact.mjs",
    "docs:deploy:kooboo:exact": "node scripts/deploy-kooboo-artifact.mjs --exact --plan .kooboo/deploy-plan.json",
    "docs:deploy:kooboo:dry-run": "node scripts/deploy-kooboo-artifact.mjs --dry-run",
    "docs:deploy:kooboo:legacy": "node scripts/deploy-kooboo.mjs",
    "docs:verify:kooboo": "node scripts/verify-kooboo-site.mjs",
    "docs:manifest:refresh": "node scripts/refresh-kooboo-manifest.mjs",
    "docs:manifest:diff": "node scripts/deploy-kooboo.mjs --skip-build --dry-run",
    "docs:sync-images": "node scripts/sync-doc-images-to-kooboo.mjs",
    "test:export:kooboo": "node --test scripts/export-vitepress-to-kooboo.test.mjs",
    "test:kooboo-manifest": "node --test scripts/kooboo-manifest.test.mjs",
    "test:local-preview": "node --test scripts/local-preview-server.test.mjs",
    "test:preview-deployment": "node --test scripts/check-docs-fast-preview.test.mjs scripts/render-preview-server-config.test.mjs",
    "test:kooboo-artifact": "node --test scripts/prepare-kooboo-artifact.test.mjs",
    "test:preview-sync": "node --test scripts/run-with-preview-lock.test.mjs scripts/sync-preview-from-git.test.mjs",
    "test:stabilize-vitepress": "node --test scripts/stabilize-vitepress-dist.test.mjs",
    "test:mermaid-diagram": "node --test scripts/mermaid-diagram.test.mjs",
    "check:dead-links": "node scripts/check-dead-links.mjs",
    "check:translations": "python3 scripts/audit-en-translation.py",
    "screenshots:cms:site": "node scripts/cms-screenshots.mjs",
    "screenshots:cms:content": "node scripts/cms-content-screenshots.mjs",
    "screenshots:cms:commerce": "node scripts/cms-commerce-screenshots.mjs",
    "screenshots:cms:development": "node scripts/cms-development-screenshots.mjs",
    "screenshots:cms:database": "node scripts/cms-database-screenshots.mjs",
    "screenshots:cms:settings": "node scripts/cms-settings-screenshots.mjs",
    "screenshots:cms:operations": "node scripts/cms-operations-screenshots.mjs",
    "screenshots:product:console": "node scripts/product-console-screenshots.mjs",
    "screenshots:product:mail": "node scripts/product-mail-screenshots.mjs",
    "screenshots:product:market": "node scripts/product-market-screenshots.mjs",
    "screenshots:product:developer-mode": "node scripts/product-developer-mode-screenshots.mjs",
    "screenshots:product:ai": "node scripts/product-ai-screenshots.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "playwright": "1.58.2",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid-diagram": "^0.3.2",
    "vue": "^3.5.30"
  },
  "dependencies": {
    "diff2html": "3.4.56",
    "vue-router": "^4.6.4"
  }
}
